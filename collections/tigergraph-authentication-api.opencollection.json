{
  "opencollection": "1.0.0",
  "info": {
    "name": "TigerGraph REST++ Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request an authentication token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/restpp/requesttoken",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchanges a GSQL-generated secret for a bearer authentication token. When token authentication is enabled, the returned token is used in the Authorization header for subsequent REST++ requests."
        }
      ]
    }
  ],
  "bundled": true
}